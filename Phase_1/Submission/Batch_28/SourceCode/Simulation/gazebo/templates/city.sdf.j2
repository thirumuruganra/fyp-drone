<?xml version="1.0" ?>
<!--
  Generated by Simulation/gazebo_world_builder.py — do not edit by hand.
  Region {{ region_id }}  bundle {{ bundle_hash }}
  World frame: ENU metres, origin = depot pad ground ({{ "%.6f"|format(lat) }}, {{ "%.6f"|format(lon) }}, {{ "%.2f"|format(h_home) }} m AMSL).
  z = H_amsl - {{ "%.2f"|format(h_home) }}.  SITL custom location must be: {{ custom_location }}
  Systems block copied from ardupilot_gazebo/worlds/iris_runway.sdf.
-->
<sdf version="1.9">
  <world name="{{ world_name }}">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
{%- if contact_system %}
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
{%- endif %}

    <scene>
      <ambient>0.85 0.85 0.85</ambient>
      <background>0.75 0.85 0.95</background>
{%- if sky %}
      <sky></sky>
{%- endif %}
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>{{ "%.8f"|format(lat) }}</latitude_deg>
      <longitude_deg>{{ "%.8f"|format(lon) }}</longitude_deg>
      <elevation>{{ "%.3f"|format(h_home) }}</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

{%- for m in models %}

    <include>
      <uri>model://{{ m }}</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
{%- endfor %}

    <model name="pads">
      <static>true</static>
      <link name="link">
{%- for p in pads %}
        <visual name="{{ p.name }}_pad">
          <cast_shadows>false</cast_shadows>
          <pose>{{ "%.3f %.3f %.3f"|format(p.x, p.y, p.z + 0.03) }} 0 0 0</pose>
          <geometry><cylinder><radius>{{ pad_radius }}</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>{{ p.rgba }}</ambient><diffuse>{{ p.rgba }}</diffuse><emissive>{{ p.rgba }}</emissive>
          </material>
        </visual>
        <visual name="{{ p.name }}_pole">
          <cast_shadows>false</cast_shadows>
          <pose>{{ "%.3f %.3f %.3f"|format(p.x + pad_radius + 0.5, p.y, p.z + pole_height / 2) }} 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>{{ pole_height }}</length></cylinder></geometry>
          <material>
            <ambient>{{ p.rgba }}</ambient><diffuse>{{ p.rgba }}</diffuse><emissive>{{ p.rgba }}</emissive>
          </material>
        </visual>
{%- endfor %}
      </link>
    </model>

    <include>
      <uri>model://{{ vehicle_model }}</uri>
      <pose degrees="true">0 0 {{ "%.3f"|format(spawn_z) }} 0 0 90</pose>
    </include>
  </world>
</sdf>
