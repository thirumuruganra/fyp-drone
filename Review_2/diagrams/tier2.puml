@startuml tier2
!theme plain
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #DDFFDD
skinparam ActivityBorderColor #444444
skinparam ArrowColor #333333

title Tier 2 — Payload-Driven Selection (select_detailed)

start
:Operator enters F (1–5), W (1–3), U (1–3), P (1–5);
if (tags are integers in range?) then (no)
  #FFD6D6:raise ValueError;
  stop
else (yes)
endif
:r_raw = 2F, d_raw = 3U, e_raw = 2W\nw_k = raw_k / Σ raw;
if (P ≥ 4?) then (yes)
  :w_max += 0.1 · w_max, renormalise;
else (no)
endif
:Min-max normalise d, ε, ρ over the front;
:score_i = w_d(1 − d̃_i) + w_e(1 − ε̃_i) + w_r(1 − ρ̃_i);
:Battery Wh_i = k_cal · ε_i · ((m_uav + m_W) / m_uav)^1.5\nfeasible if Wh_i ≤ 0.8 · battery;
if (weather NO-GO?) then (yes)
  #FFD6D6:HOLD advisory (weather);
elseif (no feasible route?) then (yes)
  #FFD6D6:HOLD advisory (battery);
else (no)
  :p* = argmax score over feasible routes;
  :Ranks per objective, point type\n(extreme / non-extreme), latency;
endif
:SelectionResult → JSON + CSV;
stop
@enduml
