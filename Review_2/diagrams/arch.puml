@startuml arch
!theme plain
skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam ArrowThickness 1.3
skinparam ArrowColor #555555
skinparam packageFontSize 12
skinparam nodesep 25
skinparam ranksep 35

title Payload-Aware Two-Tier UAV Route Planner — System Architecture

package "Environment Data Layer (env_data.py, overpass_client.py)" #EEEEEE {
  [Open-Meteo weather\nwind 80 m, gusts, rain,\nvisibility, WMO code] as WX
  [DEM provider chain\nLocal raster → OpenTopography\n→ Open-Meteo → flat] as DEM
  [OSM layers (Overpass)\nbuildings, restricted zones,\nwater, land use, roads] as OSM
  database "Disk cache\n(JSON, GeoPackage)" as CACHE
}

package "Module 1: Airspace Graph Builder" #DDEEFF {
  [Lattice node generation\n+ node selection\n(altitude, 120 m AGL, NFZ)] as NODES
  [Edge construction\n8-neighbour, NFZ cut,\nclearance filter, SCC] as EDGES
  [Shared cost pipeline\napply_weather():\nwind-aware energy +\n11-component risk] as COST
}

package "Tier 1" #D6E9F8 {
  [Module 2: NAMOA* engine\nlabel table, g+h pruning] as T1
  database "ParetoStore\nfront + metadata\n(hash, weather, expiry)" as STORE
}

package "Tier 2" #DDFFDD {
  [Module 4: Payload interpreter\nF, W, U, P → weights\n→ utility → argmax] as T2
  [Battery feasibility +\nweather HOLD] as FEAS
}

package "Evaluation" #FFF4D6 {
  [Module 3: Baselines\nA* ×3, weighted-sum A*,\nMOPSO] as BASE
  [Module 5: Metrics\nHV, IGD, spread,\nTier 2 evidence, sweep] as EVAL
}

package "Output and Validation" #FFE6CC {
  [Module 6: Mission export\nQGC WPL 110 / .plan\n+ dashboard] as EXP
  [Module 7: Gazebo +\nArduPilot SITL\nsimulation] as SIM
}

actor Operator as OP

WX --> CACHE
DEM --> CACHE
OSM --> CACHE
CACHE --> NODES
NODES --> EDGES
EDGES --> COST
WX --> COST : snapshot
COST --> T1 : G = (V, E)\nc(e) = [d, ε, ρ]
T1 --> STORE
STORE --> T2 : current front
OP --> T2 : payload tags
T2 --> FEAS
FEAS --> EXP : selected route
EXP --> SIM : mission file
COST --> BASE
T1 --> EVAL
BASE --> EVAL
T2 --> EVAL
SIM --> EVAL : flown track
@enduml
